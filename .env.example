# ============================================================
# DAUNTRA MARKETING OS
# Never put real secrets in this file.
# Copy to .env later and fill values locally.
# ============================================================

APP_ENV=development

# Supabase — configured in Section 2
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — configured in Section 3

# Postiz — configured much later
POSTIZ_API_URL=
POSTIZ_API_KEY=

# DAUNTRA
DAUNTRA_BASE_URL=https://dauntra.app
DAUNTRA_WAITLIST_URL=

# Publishing is OFF by default.
PUBLISHING_ENABLED=false

# PostgreSQL connection
# Get this from Supabase -> Connect.
# Never commit the real value.
DATABASE_URL=

# Content Brain
LLM_PROVIDER=gemini

# Gemini Developer API
# Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash


# NCBI / PubMed E-utilities
# Contact email sent to NCBI with API requests.
NCBI_EMAIL=

# Optional. Free NCBI API key for higher rate limits.
NCBI_API_KEY=
