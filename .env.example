# ============================================================
# DAUNTRA MARKETING OS
# Never put real secrets in this file.
# Copy to .env later and fill values locally.
# ============================================================

APP_ENV=development

# Supabase — configured in Section 2
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — configured in Section 3
OPENAI_API_KEY=

# Postiz — configured much later
POSTIZ_API_URL=
POSTIZ_API_KEY=

# DAUNTRA
DAUNTRA_BASE_URL=https://dauntra.app
DAUNTRA_WAITLIST_URL=

# Publishing is OFF by default.
PUBLISHING_ENABLED=false

# PostgreSQL connection
# Get this from Supabase -> Connect.
# Never commit the real value.
DATABASE_URL=
